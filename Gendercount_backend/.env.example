# Copy to .env and adjust as needed. All values are optional.
# On FastAPI Cloud, set these in the dashboard instead (your app → Environment Variables).

# API (used when running locally with start_server.ps1; FastAPI Cloud manages host and port itself)
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
# Comma-separated list of frontend origins allowed to call the API.
# In production add your Vercel URL, e.g. https://gender-stats-counter.vercel.app
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Face detection
FACE_SCORE_THRESHOLD=0.7
MIN_FACE_SIZE=20
DETECTION_MAX_SIDE=1280
# Larger photos are scaled down to this when opened, which keeps memory use low on small servers
MAX_IMAGE_SIDE=2560

# Video analysis (frames analysed per second of video)
VIDEO_SAMPLE_FPS=3
# Fingerprint similarity needed to recognise a person returning to the view (higher = fewer wrong merges)
TRACK_REID_SIMILARITY=0.55

# Upload limits (MB)
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
