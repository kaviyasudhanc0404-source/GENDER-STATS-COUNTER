# Copy to .env for local development. On Vercel, add these in Project Settings → Environment Variables.

# Backend API URL (no trailing slash). In production: your Hugging Face Space URL, e.g. https://<username>-<space-name>.hf.space
VITE_API_URL=http://localhost:8000

# Firebase web app config (Firebase console → Project settings → Your apps). These are public identifiers, not secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
